+#define SWEET_MRS(r) ({ uint64_t _v; __asm__ volatile("mrs %0, " #r : "=r"(_v)); _v; })
+
+static void
+sweet_gic_report(const char *when)
+{
+	kprintf("SWEET GIC[%s]: EL=%llu DAIF=%llx IRQen=%u cpu=%d sigen=%u\n", when,
+	    SWEET_MRS(CurrentEL) >> 2, SWEET_MRS(DAIF), (unsigned)ml_get_interrupts_enabled(),
+	    (int)cpu_number(), (unsigned)sweet_cpu_signal_is_enabled(0));
+	kprintf("  ICC SRE=%llx CTLR=%llx PMR=%llx BPR1=%llx IGRPEN1=%llx HPPIR1=%llx RPR=%llx\n",
+	    SWEET_MRS(ICC_SRE_EL1), SWEET_MRS(ICC_CTLR_EL1), SWEET_MRS(ICC_PMR_EL1),
+	    SWEET_MRS(ICC_BPR1_EL1), SWEET_MRS(ICC_IGRPEN1_EL1), SWEET_MRS(ICC_HPPIR1_EL1),
+	    SWEET_MRS(ICC_RPR_EL1));
+	kprintf("  TIMER FRQ=%llu VCT=%llx CTL=%llx CVAL=%llx KCTL=%llx\n",
+	    SWEET_MRS(CNTFRQ_EL0), SWEET_MRS(CNTVCT_EL0), SWEET_MRS(CNTV_CTL_EL0),
+	    SWEET_MRS(CNTV_CVAL_EL0), SWEET_MRS(CNTKCTL_EL1));
+}
