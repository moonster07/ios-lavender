--- a/bsd/dev/santoni_touch.c
+++ b/bsd/dev/santoni_touch.c
@@ -828,4 +828,96 @@ nvt_flat_report
 }
 
+/*
+ * 0194 (replaces the read-matrix version): the lavender device tree binds
+ * this controller as nt36525 at 0x62, i.e. the PAGED nt36xxx protocol, not
+ * the flat map 0193 assumed. Read-only probe of that protocol. One short
+ * line per read, printed every loop:
+ *   page select  = write 0xFF <page hi> <page mid>, STOP
+ *   read         = write <offset>, repeated START, read N bytes
+ * Pages (from memory of the nt36xxx driver - the point is to see which
+ * ones return sane data, not to trust them):
+ *   0x01f6 + 0x4e   chip id
+ *   0x021c / 0x011a + 0x60   firmware state (0xa0..0xaf = running)
+ *   0x021c / 0x011a + 0x00   touch report buffer
+ */
+static int
+nvt_pg_read(uint8_t addr, uint8_t hi, uint8_t mid, uint8_t reg, uint8_t *buf,
+    int len)
+{
+        int i, ok = 1;
+
+        i2c_start();
+        ok &= i2c_write((uint8_t)(addr << 1));
+        ok &= i2c_write(0xff);
+        ok &= i2c_write(hi);
+        ok &= i2c_write(mid);
+        i2c_stop();
+        if (!ok) {
+                return 5;
+        }
+        delay(300);
+        i2c_start();
+        ok &= i2c_write((uint8_t)(addr << 1));
+        ok &= i2c_write(reg);
+        if (!ok) {
+                i2c_stop();
+                return 5;
+        }
+        i2c_start();
+        ok &= i2c_write((uint8_t)((addr << 1) | 1));
+        if (!ok) {
+                i2c_stop();
+                return 5;
+        }
+        for (i = 0; i < len; i++) {
+                buf[i] = i2c_read(i != len - 1);
+        }
+        i2c_stop();
+        return 0;
+}
+
+static void
+nvt_pg_line(uint8_t addr, const char *what, uint8_t hi, uint8_t mid,
+    uint8_t reg, int len)
+{
+        uint8_t b[8];
+        int i, err;
+
+        for (i = 0; i < 8; i++) {
+                b[i] = 0;
+        }
+        err = nvt_pg_read(addr, hi, mid, reg, b, len);
+        printf("WHYRED TOUCH: NVTP %02x %s err %d:", addr, what, err);
+        for (i = 0; i < len; i++) {
+                printf(" %02x", b[i]);
+        }
+        printf("\n");
+}
+
+static void
+nvt_pg_probe(void)
+{
+        static const uint8_t addrs[] = { 0x62, 0x01 };
+        int i, ack;
+
+        printf("WHYRED TOUCH: NVTP ----\n");
+        for (i = 0; i < 2; i++) {
+                ack = i2c_ack(addrs[i]);
+                printf("WHYRED TOUCH: NVTP %02x ack %d\n", addrs[i], ack);
+                if (!ack) {
+                        continue;
+                }
+                nvt_pg_line(addrs[i], "id", 0x01, 0xf6, 0x4e, 6);
+                nvt_pg_line(addrs[i], "fw21", 0x02, 0x1c, 0x60, 2);
+                nvt_pg_line(addrs[i], "fw11", 0x01, 0x1a, 0x60, 2);
+                nvt_pg_line(addrs[i], "tc21", 0x02, 0x1c, 0x00, 6);
+                nvt_pg_line(addrs[i], "tc11", 0x01, 0x1a, 0x00, 6);
+        }
+}
+
+/* The probe loop calls nvt_flat_report(); make it run the paged probe too. */
+#define nvt_flat_report() \
+        do { nvt_flat_report(); nvt_pg_probe(); } while (0)
+
 static int
 panel_report(int acks, uint8_t first)
